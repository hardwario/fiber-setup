{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FIBER Setup",
  "mainBinaryName": "fiber-setup",
  "identifier": "com.hardwario.fiber-setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FIBER Setup",
        "width": 1280,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "publisher": "HARDWARIO a.s.",
    "copyright": "© 2026 HARDWARIO a.s.",
    "category": "Utility",
    "shortDescription": "Set up a HARDWARIO FIBER over USB",
    "longDescription": "Writes the operating system and the first-start settings (Wi-Fi, name, login) to a HARDWARIO FIBER (CM4) over its USB-B port, step by step, without J-Link or an Ethernet adapter.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/usbboot/": "usbboot/"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libusb-1.0-0"
        ]
      }
    }
  }
}
